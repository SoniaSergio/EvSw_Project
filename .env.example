# ── CONFIGURAZIONE MONGO DB ──────────────────────────────────────────────────
# URL di connessione utilizzato dai container Docker per collegarsi al database
MONGO_URI=mongodb://mongo:27017/ecgdb

# ── CHIAVE DI CIFRATURA (AES-256) ─────────────────────────────────────────────
# IMPORTANTE: 
# 1. Questa è una copia di esempio. NON inserire la chiave reale qui.
# 2. Per il corretto funzionamento, la chiave nel file .env (reale) 
#    deve essere identica sia in locale che sul server.
#
# Genera una chiave valida eseguendo questo in un terminale Python:
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
ENCRYPTION_KEY=inserisci_qui_la_tua_chiave_fernet_segreta

# ── CONFIGURAZIONE CERTIFICATI SSL (Certbot) ──────────────────────────────────
# Usa './certbot/empty' in locale (per permettere il test HTTP)
# Usa '/etc/letsencrypt' sul server (per attivare HTTPS reale)
CERTBOT_PATH=./certbot/empty