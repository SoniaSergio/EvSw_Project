# --- Database ---
MONGO_URI=mongodb://mongo:27017/ecgdb

# --- Sicurezza / Cifratura ALDE ---
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=chiave_fernet_da_generare

# --- Nginx ---
# Percorso A (localhost):   NGINX_MODE=http  | SERVER_NAME=localhost
# Percorso B (IP remoto):   NGINX_MODE=http  | SERVER_NAME=  (lascia vuoto o metti l'IP)
# Percorso C (HTTPS):       NGINX_MODE=https | SERVER_NAME=ecg.heremy.link
NGINX_MODE=https
SERVER_NAME=tuo.dominio

# --- Certbot / SSL ---
# Sviluppo locale (Percorso A/B): ./certbot/empty
# Produzione HTTPS (Percorso C):  /etc/letsencrypt
CERTBOT_PATH=/etc/letsencrypt